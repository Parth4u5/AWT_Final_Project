# Copy to backend/.env and replace EVERY placeholder before booting.
# The server fails fast (exit 1) if a required value is missing, a fallback,
# too short, or points at the leaked credential. Never commit the filled file.

# API port (default 5000). Not a secret.
PORT=5000

# MongoDB Atlas connection string using the ROTATED database user.
# Never reuse the leaked cluster/user. Example shape (replace all placeholders):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Left empty on purpose: an empty value is rejected at boot.
MONGO_URI=

# JWT signing secret: at least 32 random characters (e.g. openssl rand -hex 32).
# "changeme" is a known fallback and is rejected at boot.
JWT_SECRET=changeme

# Explicit comma-separated list of allowed browser origins. "*" is forbidden.
# e.g. http://localhost:5173,https://your-app.vercel.app
# FRONTEND_URL is accepted as a transitional alias until Phase 4, but
# ALLOWED_ORIGINS is the target variable.
ALLOWED_ORIGINS=*

# CSRF secret: at least 32 random characters, distinct from JWT_SECRET.
# Checked in a later phase; placeholder is deliberately unusable.
CSRF_SECRET=CHANGE_ME

# Redis connection URL for shared rate limiting (required in phases 4+).
REDIS_URL=redis://<host>:<port>

# Anthropic API key for the AI tutor (phase 6+; warning only until then).
ANTHROPIC_API_KEY=CHANGE_ME

# Sentry DSN for error reporting (warning only locally; required on deploy).
SENTRY_DSN=

# --- Seed script (pnpm seed) -------------------------------------------------
# The admin is created deliberately here. No registration email ever grants
# admin rights. These placeholders are never used as real credentials.
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_LOCAL_ONLY_PASSWORD
SEED_ADMIN_NAME=Local Seed Admin
