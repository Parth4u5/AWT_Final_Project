PORT=5000
# MongoDB Atlas URI (recommended)
# Replace <username>, <password>, and cluster details.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/flowVisualizerDB?retryWrites=true&w=majority&appName=<app-name>

# Optional local MongoDB URI (only for offline development)
# MONGO_URI=mongodb://127.0.0.1:27017/flowVisualizerDB

# Frontend URL for CORS in production (for example: https://your-app.vercel.app)
FRONTEND_URL=

JWT_SECRET=change_this_secret
