# Dependencies (never commit — Phase 0 task 0.1/0.2)
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Secrets — all real env files are ignored; only examples are tracked
.env
.env.*
!.env.example

# Deployment / tooling caches
.vercel/
.turbo/
coverage/
.nyc_output/
.cache/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files (mirrors JsFlow/.gitignore)
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local worktrees and agent scratch (self-ignored by their own .gitignore too)
.worktrees/
.superpowers/
